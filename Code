module safety_chip_tt (
    input [7:0] io_in, // io_in[0]=SOS Button, [1]=Fall, [2]=Gas
    output [7:0] io_out // io_out[0]=Siren, [1]=Light, [2]=Vibration
);
  wire sos = io_in[0];
  wire fall = io_in[1];
  wire gas = io_in[2];

  // Agar 3 me se koi 1 bhi 1 hua, to Siren bajega
  wire danger = sos | fall | gas;

  assign io_out[0] = danger; // Siren
  assign io_out[1] = danger; // Light
  assign io_out[2] = fall; // Vibration only on fall
  assign io_out[7:3] = 0;
endmodule
